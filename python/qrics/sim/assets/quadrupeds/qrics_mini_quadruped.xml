<mujoco model="qrics_mini_quadruped">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4" cone="pyramidal"/>
  <size njmax="400" nconmax="100"/>

  <default>
    <joint damping="1.2" armature="0.01" frictionloss="0.03"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.9 0.02 0.002" density="450" rgba="0.45 0.48 0.52 1"/>
    <position kp="38" kv="4" ctrllimited="true"/>
  </default>

  <asset>
    <texture name="checker" type="2d" builtin="checker" width="128" height="128" rgb1="0.28 0.30 0.32" rgb2="0.36 0.38 0.40"/>
    <material name="floor_mat" texture="checker" texrepeat="4 4" reflectance="0.15"/>
    <material name="base_mat" rgba="0.12 0.16 0.22 1"/>
    <material name="leg_mat" rgba="0.23 0.33 0.46 1"/>
    <material name="foot_mat" rgba="0.06 0.06 0.06 1"/>
    <material name="obstacle_mat" rgba="0.58 0.33 0.18 1"/>
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -3 4" dir="0 1 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2" directional="true"/>
    <camera name="demo_camera" pos="2.1 -2.2 1.35" xyaxes="0.74 0.67 0 -0.26 0.29 0.92"/>
    <geom name="floor" type="plane" size="8 8 0.1" material="floor_mat" friction="0.95 0.03 0.003"/>
    <geom name="low_obstacle_1" type="box" pos="1.20 0.35 0.045" size="0.22 0.12 0.045" material="obstacle_mat" mass="1.0"/>
