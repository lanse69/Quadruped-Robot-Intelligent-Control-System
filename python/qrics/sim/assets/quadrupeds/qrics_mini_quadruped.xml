            <geom name="rl_foot" type="sphere" pos="0 0 -0.195" size="0.034" material="foot_mat" mass="0.08" friction="1.1 0.03 0.003"/>
          </body>
        </body>
      </body>

      <body name="rr_hip" pos="-0.19 -0.105 0">
        <joint name="rr_hip_joint" type="hinge" axis="1 0 0" limited="true" range="-0.65 0.65" damping="1.0"/>
        <geom name="rr_hip_geom" type="capsule" fromto="0 0 0 0 -0.075 0" size="0.025" material="leg_mat" mass="0.18"/>
        <body name="rr_thigh" pos="0 -0.075 0">
          <joint name="rr_thigh_joint" type="hinge" axis="0 1 0" limited="true" range="-1.30 1.25" damping="1.3"/>
          <geom name="rr_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.17" size="0.022" material="leg_mat" mass="0.24"/>
          <body name="rr_calf" pos="0 0 -0.17">
            <joint name="rr_calf_joint" type="hinge" axis="0 1 0" limited="true" range="-2.10 0.10" damping="1.1"/>
