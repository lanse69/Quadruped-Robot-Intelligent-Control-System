            <geom name="fr_foot" type="sphere" pos="0 0 -0.195" size="0.034" material="foot_mat" mass="0.08" friction="1.1 0.03 0.003"/>
          </body>
        </body>
      </body>

      <body name="rl_hip" pos="-0.19 0.105 0">
