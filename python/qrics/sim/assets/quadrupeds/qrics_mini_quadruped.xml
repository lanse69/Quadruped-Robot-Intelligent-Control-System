    <body name="base" pos="0 0 0.38">
      <freejoint name="base_freejoint"/>
      <geom name="base_geom" type="box" size="0.27 0.13 0.055" material="base_mat" mass="4.2"/>
      <site name="imu_site" pos="0 0 0.065" size="0.015" rgba="0 0.7 1 1"/>

      <body name="fl_hip" pos="0.19 0.105 0">
        <joint name="fl_hip_joint" type="hinge" axis="1 0 0" limited="true" range="-0.65 0.65" damping="1.0"/>
        <geom name="fl_hip_geom" type="capsule" fromto="0 0 0 0 0.075 0" size="0.025" material="leg_mat" mass="0.18"/>
        <body name="fl_thigh" pos="0 0.075 0">
          <joint name="fl_thigh_joint" type="hinge" axis="0 1 0" limited="true" range="-1.30 1.25" damping="1.3"/>
          <geom name="fl_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.17" size="0.022" material="leg_mat" mass="0.24"/>
          <body name="fl_calf" pos="0 0 -0.17">
            <joint name="fl_calf_joint" type="hinge" axis="0 1 0" limited="true" range="-2.10 0.10" damping="1.1"/>
            <geom name="fl_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.18" size="0.019" material="leg_mat" mass="0.18"/>
            <geom name="fl_foot" type="sphere" pos="0 0 -0.195" size="0.034" material="foot_mat" mass="0.08" friction="1.1 0.03 0.003"/>
          </body>
        </body>
      </body>

      <body name="fr_hip" pos="0.19 -0.105 0">
        <joint name="fr_hip_joint" type="hinge" axis="1 0 0" limited="true" range="-0.65 0.65" damping="1.0"/>
