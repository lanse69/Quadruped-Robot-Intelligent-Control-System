  <actuator>
    <position name="fl_hip_pos" joint="fl_hip_joint" ctrlrange="-0.65 0.65" kp="38" kv="4"/>
    <position name="fl_thigh_pos" joint="fl_thigh_joint" ctrlrange="-1.30 1.25" kp="42" kv="4"/>
    <position name="fl_calf_pos" joint="fl_calf_joint" ctrlrange="-2.10 0.10" kp="36" kv="3"/>
    <position name="fr_hip_pos" joint="fr_hip_joint" ctrlrange="-0.65 0.65" kp="38" kv="4"/>
    <position name="fr_thigh_pos" joint="fr_thigh_joint" ctrlrange="-1.30 1.25" kp="42" kv="4"/>
    <position name="fr_calf_pos" joint="fr_calf_joint" ctrlrange="-2.10 0.10" kp="36" kv="3"/>
    <position name="rl_hip_pos" joint="rl_hip_joint" ctrlrange="-0.65 0.65" kp="38" kv="4"/>
    <position name="rl_thigh_pos" joint="rl_thigh_joint" ctrlrange="-1.30 1.25" kp="42" kv="4"/>
    <position name="rl_calf_pos" joint="rl_calf_joint" ctrlrange="-2.10 0.10" kp="36" kv="3"/>
